# 环境变量模板

# 通义千问 / 阿里云百炼（DashScope）
DASHSCOPE_API_KEY=
# OpenAI 兼容模式；华北2（北京）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4

# Qdrant
QDRANT_URL=http://localhost:6333
# 本地 Docker 无认证，留空即可（代码中会转为 None）
# 连接 Qdrant Cloud 或开启认证的服务器时填写
QDRANT_API_KEY=

# 元典 MCP（streamable HTTP；token 即元典开放平台 APIKey，以 Bearer 发送）
# 不填则外部检索自动关闭，Agent 只使用本地知识库
YUANDIAN_MCP_URL=https://open.chineselaw.com/mcp
YUANDIAN_MCP_TOKEN=

# 熔断阈值
MCP_FAILURE_THRESHOLD=3
MCP_RECOVERY_TIMEOUT=60